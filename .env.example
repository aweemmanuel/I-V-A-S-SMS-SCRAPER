# ──────────────────────────────────────────────────────────────
# IVASMS OTP Telegram Bot — environment variables
# Copy this file to .env (local) or set these in Railway Variables tab.
# ──────────────────────────────────────────────────────────────

# === Telegram (required) ===
# Get a token from @BotFather. Example: 123456789:AAEhBP0-abcDEF...
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs who can use admin features (optional).
# Find your ID by messaging @userinfobot on Telegram.
ADMIN_IDS=

# === IVASMS default credentials (optional) ===
# If set, these are used as fallback for users who haven't linked their own.
# Leave blank to force every user to add their own account via the 🔑 Account button.
IVASMS_DEFAULT_EMAIL=
IVASMS_DEFAULT_PASSWORD=
IVASMS_DEFAULT_COOKIES_JSON=

# === Polling behaviour ===
# Seconds between OTP polls when auto-poll is active (default 10)
OTP_POLL_INTERVAL_SECONDS=10
# How long an auto-poll session lasts before timing out (default 300 = 5 min)
OTP_POLL_TIMEOUT_SECONDS=300

# === Rate limiting ===
# Per-user cooldown between IVASMS API calls, in seconds (default 5)
USER_COOLDOWN_SECONDS=5

# === Database ===
# SQLite file path. On Railway, mount a volume at /data and set this to /data/bot.db
DATABASE_PATH=data/ivasms_bot.db

# === Health server (Railway needs an HTTP listener) ===
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# === Logging ===
LOG_LEVEL=INFO
